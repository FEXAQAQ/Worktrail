{
  "name": "worktrail",
  "version": "0.1.0",
  "description": "Worktrail：Claude Code 本機工作日誌系統",
  "type": "module",
  "bin": {
    "worktrail": "dist/cli.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "dev": "tsx src/cli.ts",
    "build:core": "node scripts/build.mjs --no-ui",
    "build:launcher": "node scripts/build-launcher.mjs",
    "dev:ui": "cd ui && npx vite",
    "demo:gif": "node scripts/demo/run.mjs",
    "pretest": "node scripts/build.mjs --no-ui"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^6.0.0",
    "commander": "^15.1.0",
    "fastify": "^5.12.8",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.73.0",
    "modern-screenshot": "^4.7.0",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
